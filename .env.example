# Copy to .env and fill in real values. Never commit .env.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set to 1 when served through an HTTPS reverse proxy.
DJANGO_HTTPS=0

POSTGRES_DB=kingdomsheet
POSTGRES_USER=kingdomsheet
POSTGRES_PASSWORD=replace-with-a-database-password

# Optional admin account. Sign in on the names page with this name and password.
# Leave both empty to disable admin.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional self-hosted GoatCounter pageview tracking. Leave empty to turn it off.
# Example: https://stats.example.com/count
GOATCOUNTER_URL=

GUNICORN_WORKERS=3

# Image run by `docker compose up`. Set to a ghcr.io image to run the published build.
WEB_IMAGE=kingdomsheet-web:local
